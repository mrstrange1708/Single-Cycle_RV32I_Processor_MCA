# Open-source synthesis (Member 1). Gives resource counts for a Xilinx 7-series
# FPGA, the same family Vivado targets. Run from the syn/ folder:
#   cp ../programs/test_all.hex program.hex
#   yosys -s synth_yosys.ys | tee yosys.log
read_verilog ../rtl/pc.v ../rtl/alu.v ../rtl/regfile.v ../rtl/immgen.v
read_verilog ../rtl/control.v ../rtl/imem.v ../rtl/dmem.v ../rtl/cpu.v
synth_xilinx -top cpu -family xc7
stat
